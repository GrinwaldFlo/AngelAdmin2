# AngelAdmin2 Environment Configuration
# Copy this file to .env and update the values for your environment

# Application Settings
DEBUG=true
CAKE_ENV=development
APP_IS_BETA=false
APP_DEV_IP=127.0.0.1
APP_MAINTENANCE=false

# Security
# Required: the application does not start without it.
# Generate one with: openssl rand -hex 32
SECURITY_SALT=your-32-character-random-security-salt-here

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=your_database_name
DATABASE_USER=your_database_username
DATABASE_PASSWORD=your_database_password
# Or a single DSN, which replaces the values above
# DATABASE_URL=mysql://user:password@localhost/angeladmin2

# Test Database (optional, SQLite at tmp/tests.sqlite by default)
# DATABASE_TEST_URL=mysql://user:password@localhost/angeladmin2_test

# Email Configuration
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_TLS=true

# Cache Configuration (optional)
# CACHE_DEFAULT_URL=file://tmp/cache/?prefix=angeladmin2_

# Logging URLs (optional)
# LOG_DEBUG_URL=file://logs/?file=debug
# LOG_ERROR_URL=file://logs/?file=error
# LOG_QUERIES_URL=file://logs/?file=queries
# LOG_SECURITY_URL=file://logs/?file=security

# DebugKit Configuration (development only)
DEBUG_KIT_DB_HOST=localhost
DEBUG_KIT_DB_NAME=your_database_name
DEBUG_KIT_DB_PORT=3306
DEBUG_KIT_DB_USER=your_database_username
DEBUG_KIT_DB_PASSWORD=your_database_password

DEBUG_KIT_FORCE_ENABLE=false
DEBUG_KIT_SAFE_TLD=local,localhost,test
DEBUG_KIT_IGNORE_AUTHORIZATION=false

# Cookies
SESSION_COOKIE_NAME=CakePHP

# Show slack messages
#SLACK_TOKEN=null
#SLACK_CHANNEL_ID=null
